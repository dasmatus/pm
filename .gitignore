/target
.env
.claude/worktrees/

# Demo artifacts. `examples/demo.sh` regenerates all of these.
/out
/pm.yaml
*.cpkg
*.sig
examples/.demo-config

# Local outputs from plugin builds. Integration-test components are generated
# under Cargo's ignored /target directory rather than stored in the source tree.
/plugins/target
/plugins/dist
# pm's build.rs builds the bundled plugins into its own OUT_DIR; nothing under
# plugins/bundled is generated, and no .wasm built from it is checked in.
/plugins/bundled/components
