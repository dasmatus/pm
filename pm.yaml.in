# pm's own build file -- the top of the chain, and the last thing built.
#
#   examples/01-seed  <-  examples/02-lib  <-  examples/03-app  <-  pm
#
# The graph is resolved before any of it is built, then built with as many
# packages in flight as -j allows. This chain is linear, so the order is forced
# anyway: `pm build ../pm.yaml` runs 01-seed, then 02-lib, then 03-app, then
# this. pm is genuinely compiled from source here: cargo runs inside the same
# jail every other package got.
#
# ---------------------------------------------------------------------------
# THIS IS A TEMPLATE. examples/demo.sh substitutes five placeholders and
# writes the result to <repo>/pm.yaml:
#
#   @SRCDIR@   the absolute path of the repository root
#   @HOME@     the absolute path of $HOME
#   @TRIPLE@   the host target triple, from `rustc -vV`
#   @CC@       the C compiler, canonicalised: `readlink -f $(command -v cc)`
#   @AR@       the archiver, canonicalised: `readlink -f $(command -v ar)`
#
# Every one of them is an absolute path, because a build file has no $srcdir.
# Commands run with the working directory at /build, and the only thing
# mounted from the host is this file's own directory, at its own absolute
# path. That is also why this file must sit at the repository root -- the
# mount pm gets is the directory the build file lives in, and cargo needs the
# whole source tree.
# ---------------------------------------------------------------------------
name: pm
version:
- '0'
- '1'
- '0'
dependencies:
- ../examples/03-app/build.yaml
steps:

# The sharp version of the confinement probes. examples/*/build.yaml can only
# assert machine-independent paths; this file is generated, so it can name the
# real $HOME and the real source tree.
- stage: Prepare
  dl_urls: null
  name: confine
  run:
  # The source tree IS reachable -- it is this build file's own directory, and
  # cargo could not work without it -- but only to read.
  - test -d @SRCDIR@
  - test -f @SRCDIR@/Cargo.toml
  - test ! -w @SRCDIR@
  # And this is the claim worth making. The repository lives under $HOME, so
  # the jail necessarily contains the path components leading down to it --
  # `ls /home` inside the jail does show a directory. That spine is hollow:
  # nothing else in $HOME is mounted, and none of these four exist in the jail
  # while all four exist on the host.
  - test ! -e @HOME@/.ssh
  - test ! -e @HOME@/.config
  - test ! -e @HOME@/.local
  - test ! -e @HOME@/.bashrc
  # Same machine-independent probes the examples make.
  - test ! -e /root
  - test ! -e /var
  - test ! -w /usr
  - test ! -e /tmp/pm-confinement-decoy/secret.txt
  - test -w /build
  - test -w /dest
  - test -f /dest/deps/app-0.1.0.cpkg

# Compile. `cargo` is spelled bare: pm resolves a step's first word against the
# HOST PATH and hands execve the canonicalised result, which is how a toolchain
# installed outside /usr is reachable at all (BuildSandbox::resolve).
#
# The cargo fingerprint grants Toolchain, Coreutils and Network, so this is the
# one package in the chain whose jail shares the host network namespace --
# cargo resolves and downloads the dependency graph itself. `pm explain` shows
# the difference: every other package here gets Coreutils and an empty netns.
#
# --target-dir keeps every write inside /build, the working directory, because
# the source tree is mounted read-only. --locked stops cargo from trying to
# rewrite Cargo.lock, which is on that read-only mount. CARGO_HOME lands at
# /build/.cargo because the jail sets HOME=/build in BuildSandbox::run_jailed,
# so the registry cache is per-build and thrown away with the workspace.
#
# The three --config flags are what this jail costs, and they are worth
# understanding. pm resolves the FIRST WORD of a step against the host PATH,
# but nothing else: once cargo is running, its own lookups of `rustc` and `cc`
# go through the container's PATH, which is a fixed
# /usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
# (CONTAINER_PATH in src/sandbox.rs). On a host whose toolchain lives under
# $HOME -- a Nix profile, rustup, homebrew -- it finds nothing, because $HOME
# is not mounted. The binaries themselves ARE reachable, at their canonical store
# paths, so naming them explicitly is the fix. Without this, cargo gets as far
# as compiling build scripts and then dies with `linker \`cc\` not found`.
#
# There is no shell, so the quotes below are not stripped by anything -- they
# arrive at cargo as part of the argument, which is exactly the TOML it wants.
- stage: Build
  dl_urls: null
  name: compile
  run:
  - cargo build --release --locked --manifest-path @SRCDIR@/Cargo.toml --target-dir /build/target --config target.@TRIPLE@.linker="@CC@" --config env.CC="@CC@" --config env.AR="@AR@"

# Stage the binary. DESTDIR is /dest, passed through the environment, but there
# is no shell to expand it, so it is written out.
- stage: Install
  dl_urls: null
  name: install
  run:
  - install -Dm755 /build/target/release/pm /dest/usr/bin/pm
